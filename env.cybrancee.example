# PalControl v0.6.0 — production/Cybrancee template
PALCONTROL_HOST=0.0.0.0
PALCONTROL_PORT=8787
PUBLIC_BASE_URL=
PANEL_PASSWORD=
SESSION_SECRET=
DATABASE_PATH=./data/palcontrol.sqlite

SERVER_PROVIDER=gportal
PALWORLD_REST_URL=
PALWORLD_REST_USERNAME=admin
PALWORLD_ADMIN_PASSWORD=
PALWORLD_REST_TIMEOUT_MS=8000
PALWORLD_GAME_DATA_ENABLED=false

PALWORLD_RCON_HOST=
PALWORLD_RCON_PORT=25575
PALWORLD_RCON_TIMEOUT_MS=8000
# Optional; blank = reuse PALWORLD_ADMIN_PASSWORD
PALWORLD_RCON_PASSWORD=

FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_SECURE=false
PALWORLD_REMOTE_SAVE_PATH=
PALDEFENDER_REMOTE_LOG_PATH=
REMOTE_CACHE_DIR=./data/remote-cache

# GPORTAL UE4SS bridge — recommended
UE4SS_BRIDGE_ENABLED=true
UE4SS_BRIDGE_REMOTE_DIR=/Pal/Binaries/Win64/ue4ss/Mods/PalControlBridge/data
UE4SS_BRIDGE_POLL_MS=3000
UE4SS_BRIDGE_WORLD_POLL_MS=10000
UE4SS_BRIDGE_COMMAND_TIMEOUT_MS=12000
# Disabled by default: enable only after live spawn testing on this server build.
UE4SS_BRIDGE_SPAWN_ENABLED=false
# Leave the legacy actor path blank when using the unified bridge.
PALWORLD_REMOTE_ACTOR_PATH=

SAVE_READER_ENABLED=false
# Leave blank to auto-select the bundled binary for the current OS when available.
SAVE_READER_BIN=
SAVE_READER_TIMEOUT_MS=30000

PALDEFENDER_API_ENABLED=false
PALDEFENDER_API_URL=http://127.0.0.1:17993
PALDEFENDER_API_TOKEN=
PALDEFENDER_API_TIMEOUT_MS=8000
PALDEFENDER_WHITELIST_ENABLED=false

SHOP_ENABLED=true
SHOP_CATALOG_PATH=./config/shop.json
SHOP_PLAYTIME_COINS_PER_HOUR=0
SHOP_VIP_PLAYTIME_COINS_PER_HOUR=0
SHOP_KILL_REWARD=0

DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Test: set guild ID for instant command updates. Production global: leave blank.
DISCORD_GUILD_ID=
DISCORD_CHAT_CHANNEL_ID=
DISCORD_LOG_CHANNEL_ID=
DISCORD_REGISTER_COMMANDS=true
DISCORD_BRIDGE_ENABLED=true

BACKUP_DIR=./backups
BACKUP_RETENTION=48
BACKUP_ALLOW_RESTORE=true
WATCHDOG_ENABLED=false

BRAND_NAME=PalControl
BRAND_FOOTER=PalControl • Palworld Server Control
BRAND_ICON_URL=
